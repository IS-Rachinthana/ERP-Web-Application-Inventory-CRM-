generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  STAFF
}
enum Segment {
  RETAIL
  WHOLESALE
}
enum Currency {
  USD
  AED
  LKR
}
enum LedgerType {
  GRN
  GDN
  ADJUSTMENT
}
enum AppRole {
  OWNER
  ADMIN
  MANAGER
  SALES_REP
  STOREKEEPER
  ACCOUNTANT
  TECHNICIAN
}

model User {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  role Role @default(STAFF)
  createdAt DateTime @default(now())
}
model Profile {
  id String @id @db.Uuid
  email String @unique
  fullName String?
  role AppRole @default(STOREKEEPER)
  isActive Boolean @default(true)
  branchId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  auditLogs AuditLog[]
}
model AuditLog {
  id String @id @default(cuid())
  actorId String? @db.Uuid
  action String
  entityType String
  entityId String?
  detail Json?
  createdAt DateTime @default(now())
  actor Profile? @relation(fields: [actorId], references: [id], onDelete: SetNull)
}
model CompanySetting {
  id String @id @default(cuid())
  name String
  currency Currency @default(USD)
  updatedAt DateTime @updatedAt
}
model Branch {
  id String @id @default(cuid())
  name String
  code String @unique
  address String?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
}
model TaxRate {
  id String @id @default(cuid())
  name String
  rate Decimal @db.Decimal(5, 2)
  isActive Boolean @default(true)
}
model Unit {
  id String @id @default(cuid())
  name String
  symbol String @unique
}
model Supplier {
  id String @id @default(cuid())
  name String
  country String?
  contactName String?
  email String?
  phone String?
  address String?
  createdAt DateTime @default(now())
  grns Grn[]
}
model Customer {
  id String @id @default(cuid())
  name String
  segment Segment @default(RETAIL)
  country String?
  email String? @unique
  phone String?
  address String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  invoices Invoice[]
}
model Product {
  id String @id @default(cuid())
  sku String @unique
  name String
  description String?
  costPrice Decimal @default(0) @db.Decimal(14, 4)
  sellingPrice Decimal @default(0) @db.Decimal(14, 4)
  quantityOnHand Int @default(0)
  reorderLevel Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  grnItems GrnItem[]
  invoiceItems InvoiceItem[]
  stockLedger StockLedger[]
}
model ExchangeRate {
  currency Currency @id
  ratePerUsd Decimal @db.Decimal(18, 6)
  updatedAt DateTime @updatedAt
}
model DocCounter {
  key String @id
  value Int @default(0)
}
model Grn {
  id String @id @default(cuid())
  number String @unique
  supplierId String?
  currency Currency @default(USD)
  ratePerUsd Decimal @db.Decimal(18, 6)
  receivedAt DateTime @default(now())
  notes String?
  createdAt DateTime @default(now())
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items GrnItem[]
}
model GrnItem {
  id String @id @default(cuid())
  grnId String
  productId String
  quantity Int
  unitCost Decimal @db.Decimal(14, 4)
  grn Grn @relation(fields: [grnId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  @@unique([grnId, productId])
}
model Invoice {
  id String @id @default(cuid())
  number String @unique
  customerId String?
  currency Currency @default(USD)
  ratePerUsd Decimal @db.Decimal(18, 6)
  issuedAt DateTime @default(now())
  notes String?
  createdAt DateTime @default(now())
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items InvoiceItem[]
}
model InvoiceItem {
  id String @id @default(cuid())
  invoiceId String
  productId String
  quantity Int
  unitPrice Decimal @db.Decimal(14, 4)
  costPriceAtSale Decimal @db.Decimal(14, 4)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  @@unique([invoiceId, productId])
}
model StockLedger {
  id String @id @default(cuid())
  productId String
  type LedgerType
  quantity Int
  refType String
  refId String
  note String?
  createdAt DateTime @default(now())
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}
